# Google Gemini API Key (Free Tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Telegram Bot Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Backend Configuration
DATABASE_PATH=./job_hunter.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration (in frontend/.env.local if needed)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Supabase Auth (Sign In / Sign Up only — no file storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
